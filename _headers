/assets/photos/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Short cache while the design is being actively iterated: the browser
# revalidates every time (cheap 304 via ETag) so CSS/JS changes show up on a
# normal refresh, no hard-refresh needed. Bump these back up (e.g. max-age=86400)
# once the design settles, for a small performance win.
/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/script.js
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
