# Files in the repo that should NOT be uploaded as public site assets.
# Same syntax as .gitignore. Fixes Cloudflare "Asset too large" from .git history.
.git
.gitignore
.assetsignore
wrangler.jsonc
wrangler.toml
node_modules
*.md

# Unused source originals: every photo in assets/photos/ ships as an optimized
# .jpg; the .png masters (~94 MB) are kept in the repo but never served.
# (assets/thoughtful.png lives outside this folder and IS used, so it stays.)
assets/photos/*.png
